# Slack MCPL server configuration
# Copy to .env (or export in the spawn environment) and fill in.

# Bot User OAuth Token (xoxb-...) — Web API calls
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token (xapp-...) with connections:write — Socket Mode events
SLACK_APP_TOKEN=xapp-your-app-token

# Legacy mode only; ignored when SLACK_ACCESS_POLICY is set.
# Optional: comma-separated user-ID whitelist for DMs (drop DMs from others)
#SLACK_DM_USERS=U0123ABC,U0456DEF

# Optional: persist ambient-channel subscriptions across restarts
#SLACK_SUBSCRIPTIONS_FILE=/var/lib/slack-mcpl/subscriptions.json

# Optional: backscroll size on first interaction with a conversation (default 50)
#SLACK_BACKSCROLL_LIMIT=50

# Optional: diagnostic file log (absolute path)
#SLACK_MCPL_DEBUG_LOG=/tmp/slack-mcpl-debug.log

# Optional complete restart-only policy. Replaces SLACK_DISABLE_DMS,
# SLACK_DM_USERS and SLACK_SEND_CHANNELS; remove those legacy settings first.
# Empty/invalid stops startup. DM peers gain reads AND writes.
# find_user remains workspace-wide; rollback file deletion needs files:read.
# See docs/access-policy-migration.md before migrating.
#SLACK_ACCESS_POLICY='{"readJoinedChannels":true,"writeChannels":["CEXAMPLE"],"dmUsers":["UEXAMPLE"]}'

# Successful pagination pages per operation, before membership/query filtering.
# Canonical decimal integers 1..10000 only; invalid values refuse startup.
# Larger limits cost more memory and requests; repeated calls do not resume.
# SLACK_CONVERSATION_PAGE_LIMIT=1000
# SLACK_USER_PAGE_LIMIT=1000
# SLACK_BACKSCROLL_PAGE_LIMIT=100
