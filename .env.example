# Slack MCPL server configuration
# Copy to .env (or export in the spawn environment) and fill in.

# Bot User OAuth Token (xoxb-...) — Web API calls
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token (xapp-...) with connections:write — Socket Mode events
SLACK_APP_TOKEN=xapp-your-app-token

# Optional: comma-separated user-ID whitelist for DMs (drop DMs from others)
#SLACK_DM_USERS=U0123ABC,U0456DEF

# Optional: persist ambient-channel subscriptions across restarts
#SLACK_SUBSCRIPTIONS_FILE=/var/lib/slack-mcpl/subscriptions.json

# Optional: backscroll size on first interaction with a conversation (default 50)
#SLACK_BACKSCROLL_LIMIT=50

# Optional: diagnostic file log (absolute path)
#SLACK_MCPL_DEBUG_LOG=/tmp/slack-mcpl-debug.log
